{
  "realm": "groceries",
  "enabled": true,
  "displayName": "Einkaufsliste",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "sslRequired": "none",
  "loginTheme": "groceries",
  "emailTheme": "groceries",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "de"
  ],
  "defaultLocale": "de",
  "passwordPolicy": "length(8) and maxLength(128) and hashAlgorithm(argon2)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "accessTokenLifespan": 300,
  "actionTokenGeneratedByUserLifespan": 3600,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@einkaufsliste.localhost",
    "fromDisplayName": "Einkaufsliste",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"displayName\", \"displayName\": \"${displayName}\", \"validations\": {\"length\": {\"min\": 1, \"max\": 50}}, \"required\": {\"roles\": [\"user\", \"admin\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": []}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "groceries-bff",
      "name": "Groceries BFF (OIDC login, ADR 0002)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "baseUrl": "http://localhost:8080/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/",
        "backchannel.logout.url": "http://host.docker.internal:8080/logout/connect/back-channel/keycloak",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "defaultClientScopes": [
        "basic",
        "email",
        "acr"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "displayName",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "displayName",
            "claim.name": "displayName",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "name from displayName",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "displayName",
            "claim.name": "name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "anna@example.test",
      "email": "anna@example.test",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "displayName": [
          "Anna"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Passwort-1",
          "temporary": false
        }
      ]
    },
    {
      "username": "ben@example.test",
      "email": "ben@example.test",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "displayName": [
          "Ben"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Passwort-2",
          "temporary": false
        }
      ]
    }
  ]
}