{
  "name": "groceries-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "generate:api": "node scripts/generate-api.mjs",
    "build": "npm run generate:api && ng build",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:arch": "depcruise --config .dependency-cruiser.cjs src && vitest run --config vitest.arch.config.ts",
    "check:unused": "knip",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "npm run generate:api && ng test --watch=false",
    "e2e": "playwright test --project='stubbed-*'",
    "e2e:fast": "playwright test --project=stubbed-expanded",
    "e2e:nightly": "playwright test --project='stubbed-*' --project='nightly-*'",
    "check": "node scripts/verify.mjs generate:api! typecheck lint check:arch test",
    "verify": "node scripts/verify.mjs generate:api! format:check lint typecheck check:arch check:unused test build! e2e",
    "new:feature": "node scripts/new-feature.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@fontsource/roboto": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "intl-messageformat": "12.1.5",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.7.0",
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@ngrx/eslint-plugin": "22.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.6",
    "angular-eslint": "22.7.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "orval": "8.48.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
